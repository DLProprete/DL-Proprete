generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLANNER
  AGENT
}

enum BillingMode {
  TIME_AND_MATERIALS_PLANNED
}

enum BillingBasis {
  CALENDAR_SHIFTS
  FLAT_INDICATIVE_HOURS
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ENDED
}

enum ShiftStatus {
  PLANNED
  PARTIALLY_STAFFED
  UNSTAFFED
  DONE
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  REPLACED
  CANCELLED
}

enum HolidayScope {
  COMPANY
}

enum ServiceExceptionType {
  SKIP
  EXTRA
}

enum TimeEntryStatus {
  OPEN
  SUBMITTED
  VALIDATED
  REJECTED
}

enum TimeEntrySource {
  MOBILE
  ADMIN
}

enum AbsenceType {
  PAID_LEAVE
  RTT
  SICK
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ElectronicStatus {
  NOT_APPLICABLE
}

enum InvoiceLineSource {
  PLANNED_HOURS
  ADHOC
}

enum PaymentMethod {
  TRANSFER
  CHEQUE
  CASH
  OTHER
}

// --- Authentification (Better Auth) ---
// User porte à la fois l'identité Better Auth (email, emailVerified, name,
// image) et les données métier (role, firstName/lastName, etc.).
// Le mot de passe hashé n'est pas stocké ici : Better Auth le place dans
// Account (provider "credential"), voir docs/ARCHITECTURE.md section 3.

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       Boolean   @default(false)
  name                String
  image               String?
  firstName           String
  lastName            String
  phone               String?
  role                Role      @default(AGENT)
  weeklyContractHours Decimal?  @db.Decimal(5, 2)
  // Solde de congés acquis, saisi manuellement (jours) — pas de moteur de
  // paie/accrual ici (règle dure CLAUDE.md), la règle d'acquisition réelle
  // (CCN, temps partiel, report) n'est pas dans la spec. Concerne tout
  // salarié, pas seulement le terrain (audit du 31/08/2026, Mo9).
  paidLeaveBalance    Decimal?  @db.Decimal(5, 2)
  classification      String?
  isActive            Boolean   @default(true)
  hiredAt             DateTime?
  endedAt             DateTime?
  // --- Profil agent (Session 10) ---
  // Pas de date de naissance : la paie est externalisée (§8, principe de
  // minimisation), rien dans l'outil n'en a besoin. Retirée le 31/08/2026
  // (audit Mo10) — colonne supprimée en base, pas juste masquée en UI.
  homeAddress         String?
  homeCity            String?
  homePostalCode      String?
  homeLat             Float?
  homeLng             Float?
  hasDrivingLicense   Boolean   @default(false)
  // Heure murale (ancrée 1970-01-01 UTC), même convention que
  // ServiceTemplate.startTime/endTime — voir src/lib/dates.ts.
  maxEndTime          DateTime? @db.Time
  minStartTime        DateTime? @db.Time
  noWorkWeekdays      Int[]     @default([])
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions             Session[]
  accounts             Account[]
  assignments          Assignment[]
  timeEntries          TimeEntry[]
  absences             Absence[]
  validatedTimeEntries TimeEntry[]  @relation("TimeEntryValidatedBy")
  auditLogs            AuditLog[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  // Identifiant synthétique de la méthode d'auth, ex. "local:credential"
  // pour email+mot de passe. C'est la clé réellement utilisée par Better
  // Auth pour retrouver un compte (voir @better-auth/core/db/schema/account),
  // pas providerId seul.
  issuer                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// --- Métier ---

model Client {
  id              String   @id @default(cuid())
  legalName       String
  tradeName       String?
  siret           String?
  vatNumber       String?
  billingAddress  String
  email           String?
  phone           String?
  paymentTermDays Int      @default(30)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sites     Site[]
  contracts Contract[]
  invoices  Invoice[]
}

// Portail client par lien magique — volontairement independant de
// src/lib/auth.ts (aucune table, aucun cookie partages avec le staff).
// clientId en reference libre, meme convention que Prospect.convertedClientId.
model ClientPortalToken {
  id        String    @id @default(cuid())
  clientId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ClientPortalSession {
  id        String   @id @default(cuid())
  clientId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  WON
  LOST
}

// Pipeline commercial (prospects pas encore signés). convertedClientId est
// une reference libre (pas de @relation), meme convention qu'AuditLog.entityId
// - la conversion cree un Client independant, ce modele ne touche jamais
// au modele Client.
model Prospect {
  id                String         @id @default(cuid())
  legalName         String
  contactName       String?
  phone             String?
  email             String?
  address           String?
  source            String?
  notes             String?
  status            ProspectStatus @default(NEW)
  nextFollowUpAt    DateTime?
  convertedClientId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
}

model Site {
  id                 String   @id @default(cuid())
  clientId           String
  name               String
  address            String
  city               String
  postalCode         String
  accessNotes        String?
  onSiteContactName  String?
  onSiteContactPhone String?
  surfaceM2          Decimal? @db.Decimal(8, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client            Client             @relation(fields: [clientId], references: [id])
  contracts         Contract[]
  shifts            Shift[]
  timeEntries       TimeEntry[]
  serviceExceptions ServiceException[]

  @@index([clientId])
}

model Contract {
  id                     String         @id @default(cuid())
  clientId               String
  siteId                 String
  reference              String
  startsOn               DateTime       @db.Date
  endsOn                 DateTime       @db.Date
  billingMode            BillingMode    @default(TIME_AND_MATERIALS_PLANNED)
  billingBasis           BillingBasis   @default(FLAT_INDICATIVE_HOURS)
  hourlyRateHT           Decimal        @db.Decimal(8, 2)
  indicativeMonthlyHours Decimal?       @db.Decimal(7, 2)
  vatRate                Decimal        @default(20) @db.Decimal(4, 2)
  billingDayOfMonth      Int            @default(1)
  status                 ContractStatus @default(DRAFT)
  renewalNoticeDays      Int            @default(60)
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  client           Client            @relation(fields: [clientId], references: [id])
  site             Site              @relation(fields: [siteId], references: [id])
  serviceTemplates ServiceTemplate[]
  shifts           Shift[]
  invoices         Invoice[]

  @@index([endsOn, status])
  @@index([siteId, status])
}

model ServiceTemplate {
  id              String   @id @default(cuid())
  contractId      String
  name            String
  daysOfWeek      Int[]
  startTime       DateTime @db.Time
  endTime         DateTime @db.Time
  durationMinutes Int
  requiredAgents  Int      @default(1)
  instructions    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contract          Contract           @relation(fields: [contractId], references: [id])
  shifts            Shift[]
  serviceExceptions ServiceException[]

  @@index([contractId])
}

model Shift {
  id                    String      @id @default(cuid())
  serviceTemplateId     String?
  siteId                String
  contractId            String
  date                  DateTime    @db.Date
  startAt               DateTime
  endAt                 DateTime
  requiredAgents        Int
  // Durée vendue de la vacation, en minutes, recopiee du ServiceTemplate au
  // moment de la generation. Figee volontairement : modifier le contrat plus
  // tard ne doit jamais changer retroactivement une periode deja facturee.
  // Distincte de endAt - startAt, qui est la fenetre d'acces au site.
  billableMinutes       Int
  status                ShiftStatus @default(UNSTAFFED)
  generatedFromTemplate Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  serviceTemplate ServiceTemplate? @relation(fields: [serviceTemplateId], references: [id])
  site            Site             @relation(fields: [siteId], references: [id])
  contract        Contract         @relation(fields: [contractId], references: [id])
  assignments     Assignment[]
  timeEntries     TimeEntry[]

  @@unique([serviceTemplateId, date, startAt], name: "uniq_generated_occurrence")
  @@index([date, siteId])
  @@index([contractId, date])
}

model Assignment {
  id                     String           @id @default(cuid())
  shiftId                String
  userId                 String
  status                 AssignmentStatus @default(ASSIGNED)
  replacedByAssignmentId String?          @unique
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  shift                Shift        @relation(fields: [shiftId], references: [id])
  user                 User         @relation(fields: [userId], references: [id])
  replacedByAssignment Assignment?  @relation("Replacement", fields: [replacedByAssignmentId], references: [id])
  replacementOf        Assignment[] @relation("Replacement")

  @@index([userId, shiftId])
}

model TimeEntry {
  id                String          @id @default(cuid())
  userId            String
  siteId            String
  shiftId           String?
  clockInAt         DateTime
  clockOutAt        DateTime?
  status            TimeEntryStatus @default(OPEN)
  source            TimeEntrySource @default(MOBILE)
  note              String?
  validatedById     String?
  validatedAt       DateTime?
  payrollExportable Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user        User   @relation(fields: [userId], references: [id])
  site        Site   @relation(fields: [siteId], references: [id])
  shift       Shift? @relation(fields: [shiftId], references: [id])
  validatedBy User?  @relation("TimeEntryValidatedBy", fields: [validatedById], references: [id])

  @@index([userId, clockInAt])
}

// Deux garde-fous poses en base par migration brute (pas exprimables dans
// le DSL Prisma, donc invisibles ci-dessus) :
// - index unique partiel `uniq_open_time_entry` sur (userId) WHERE
//   status = 'OPEN' : un seul pointage ouvert a la fois par agent.
// - contrainte CHECK `TimeEntry_min_duration` : clockOutAt IS NULL OR
//   clockOutAt >= clockInAt + 5 minutes (voir migration
//   20260831173748_time_entry_min_duration).

model Absence {
  id           String        @id @default(cuid())
  userId       String
  type         AbsenceType
  startsOn     DateTime      @db.Date
  endsOn       DateTime      @db.Date
  status       AbsenceStatus @default(PENDING)
  documentPath String?
  comment      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startsOn])
}

model Invoice {
  id               String           @id @default(cuid())
  clientId         String
  contractId       String?
  // Mois de prestation facturé (pas la date d'émission, qui peut être le
  // mois suivant — cf. Contract.billingDayOfMonth). Sert à empêcher de
  // refacturer une même période pour un même contrat une fois émise ;
  // absent de docs/DATA-MODEL.md, ajout technique voir docs/ARCHITECTURE.md.
  periodYear       Int?
  periodMonth      Int?
  number           String?          @unique
  issuedOn         DateTime?        @db.Date
  dueOn            DateTime?        @db.Date
  status           InvoiceStatus    @default(DRAFT)
  electronicStatus ElectronicStatus @default(NOT_APPLICABLE)
  amountHT         Decimal          @default(0) @db.Decimal(10, 2)
  vatAmount        Decimal          @default(0) @db.Decimal(10, 2)
  amountTTC        Decimal          @default(0) @db.Decimal(10, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  client   Client        @relation(fields: [clientId], references: [id])
  contract Contract?     @relation(fields: [contractId], references: [id])
  lines    InvoiceLine[]
  payments Payment[]

  @@index([status, issuedOn])
  @@index([contractId, periodYear, periodMonth])
}

model InvoiceLine {
  id          String            @id @default(cuid())
  invoiceId   String
  label       String
  quantity    Decimal           @db.Decimal(8, 2)
  unitPriceHT Decimal           @db.Decimal(10, 2)
  vatRate     Decimal           @db.Decimal(4, 2)
  source      InvoiceLineSource
  hours       Decimal?          @db.Decimal(7, 2)
  createdAt   DateTime          @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  paidOn    DateTime      @db.Date
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  createdAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  // Identite de l'acteur figee au moment de l'ecriture ("Prenom Nom ·
  // email"). La FK actorUserId est en ON DELETE SET NULL : sans cette
  // copie, supprimer un compte (fixture de test jetable, depart d'un
  // salarie) efface retroactivement qui a fait quoi dans tout l'historique.
  actorLabel  String?
  action      String
  entityType  String
  entityId    String
  summary     String
  metadata    Json?

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
}

// Numérotation de facture F-YYYY-NNNN sans trou, remise à zéro chaque année
// civile (voir docs/ARCHITECTURE.md section 3) — pas dans docs/DATA-MODEL.md.
model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0)
}

// Ligne unique (id fixe "default") : coordonnées de l'entreprise pour le
// pied de page des factures PDF (docs/ARCHITECTURE.md section 4, module 9).
// Mentions obligatoires des factures entre professionnels (art. L441-9 du code
// de commerce). Voir server/billing/legal-mentions.ts pour leur mise en forme.
model CompanyProfile {
  id        String   @id @default("default")
  legalName String
  address   String
  legalForm String?
  // Capital social : mention obligatoire pour une societe commerciale.
  shareCapital Decimal? @db.Decimal(12, 2)
  // Ville du greffe ; le SIREN est derive des 9 premiers chiffres du SIRET.
  rcsCity   String?
  siret     String?
  vatNumber String?
  iban      String?
  // Taux annuel des penalites de retard, en %. Null = repli legal (trois fois
  // le taux d'interet legal), qui reste une mention valable.
  latePenaltyRate Decimal? @db.Decimal(5, 2)
  // Nombre de jours avant echeance a partir duquel une facture apparait
  // dans /invoices/reminders. Choix business, pas une regle legale.
  reminderWindowDays Int @default(7)
  updatedAt DateTime @updatedAt
}

// Jours fériés France (Calvados = métropole, pas de jour local spécifique) —
// le générateur de Shift (docs/ARCHITECTURE.md module 4) ignore ces dates.
model Holiday {
  id    String       @id @default(cuid())
  date  DateTime     @db.Date
  name  String
  scope HolidayScope @default(COMPANY)

  @@unique([date, scope])
}

// SKIP (n'exécute pas ce créneau normalement planifié) ou EXTRA (force une
// occurrence hors planning habituel), rattaché à une ServiceTemplate ou à un
// Site entier — au moins l'un des deux, validé en Zod/action (comme
// Absence.documentPath pour SICK), pas en contrainte SQL.
model ServiceException {
  id                String               @id @default(cuid())
  serviceTemplateId String?
  siteId            String?
  date              DateTime             @db.Date
  type              ServiceExceptionType
  notes             String?
  createdAt         DateTime             @default(now())

  serviceTemplate ServiceTemplate? @relation(fields: [serviceTemplateId], references: [id])
  site            Site?            @relation(fields: [siteId], references: [id])

  @@index([date])
}
